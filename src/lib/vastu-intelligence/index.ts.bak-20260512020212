export function normalizeDirection(value: DirectionCode | string | undefined): DirectionCode {
  if (!value) return "CENTER";
  const key = String(value).trim().toLowerCase();
  return DIRECTION_ALIASES[key] ?? (String(value).toUpperCase() as DirectionCode);
}

